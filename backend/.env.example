PORT=6969
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_NAME=dacs_ecommerce
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
URL_REACT=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false

# Email delivery (Gmail requires an app password)
EMAIL_APP=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=

# Optional payment providers; empty credentials disable that method explicitly.
VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:3000/payment/vnpay_return
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
USD_EXCHANGE_RATE=24300

# Set all TEST_DB_* variables before running database-backed checks on a separate DB.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_DATABASE_NAME=dacs_ecommerce_test
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=
