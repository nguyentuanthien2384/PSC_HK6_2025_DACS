PORT=6969
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_NAME=dacs_ecommerce
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
URL_REACT=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false

# Email delivery (Gmail requires an app password)
EMAIL_APP=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=

# Optional payment providers; empty credentials disable that method explicitly.
VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:3000/payment/vnpay_return
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
USD_EXCHANGE_RATE=24300

# Gateway callbacks require a publicly reachable HTTPS URL registered at the provider.
# PayPal webhook ID is issued separately for sandbox and live apps.
PAYPAL_WEBHOOK_ID=
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_IPN_URL=
PAYMENT_SERVER_IP=127.0.0.1
BACKGROUND_JOBS_ENABLED=true
RECONCILIATION_INTERVAL_MS=60000

# Shipping provider accounts/tokens are separate between sandbox and production.
GHN_MODE=sandbox
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
GHTK_MODE=sandbox
GHTK_TOKEN=
GHTK_PARTNER_CODE=
GHTK_WEBHOOK_SECRET=
# GHTK needs the pickup address; GHN uses the registered ShopId address.
SHIPPING_PICK_NAME=
SHIPPING_PICK_PHONE=
SHIPPING_PICK_ADDRESS=
SHIPPING_PICK_PROVINCE=
SHIPPING_PICK_DISTRICT=
SHIPPING_PICK_WARD=

# Whole-order return policy and own-courier retry limit.
RETURN_WINDOW_DAYS=7
DELIVERY_MAX_ATTEMPTS=3

# Set all TEST_DB_* variables before running database-backed checks on a separate DB.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_DATABASE_NAME=dacs_ecommerce_test
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=

# Initial administrator; set these explicitly before npm run db:seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional password override for demo accounts (default: Demo@123456).
# Only used when initially inserting the demo dataset; reruns preserve passwords.
SEED_DEMO_PASSWORD=
